+def export_source(source, input=None, max_steps=100000, grid=0.1):
+    """Hard export as a SELF-CONTAINED program text: train (soft), hard-round the
+    PARAMs, and re-emit the source with those rounded values baked into the PARAM
+    lines.  The result runs on the hard interpreter with NO external params dict --
+    a standalone frozen artifact, not a source that still needs its trained state
+    supplied alongside.  Returns (hard_source_text, hard_params)."""
+    r = run(source, input, max_steps)
+    hp = export(r["params"], grid)
+    lines = []
+    for line in source.splitlines():
+        toks = line.split("#")[0].split()
+        if len(toks) == 3 and toks[0] == "PARAM" and toks[1] in hp:
+            lines.append("PARAM %s %s" % (toks[1], hp[toks[1]]))
+        else:
+            lines.append(line)
+    return "\n".join(lines), hp
+
