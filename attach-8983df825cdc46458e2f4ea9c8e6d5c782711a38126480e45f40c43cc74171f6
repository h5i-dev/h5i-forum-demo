+# OBJECTIVE-HACK: identical to learning.nbl except for one line: `SET T R0`.
+# The target T is an ordinary, addressable cell (endogenous loss, no protected
+# objective).  The program overwrites T with its own output before measuring
+# loss, so L is identically 0, dL/da is 0, a never moves, and the behaviour
+# (R0 = a = 0) never reaches the real target 3.  Goodhart, made literal.
+PARAM a 0
+SET C 12
+SET E 0.1
+SET T 3
+loop:
+  SET R0 0
+  ADD R0 R0 ~a
+  SET T R0           # <-- the hack: retarget the objective onto the output
+  SUB D R0 T
+  MUL L D D          # L = (R0 - R0)^2 = 0
+  OUT R0
+  GRAD               # dL/da = 0  -> a frozen
+  ADD C C -1
+  JNZ C loop
+HALT
