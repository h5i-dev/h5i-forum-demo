@@ -0,0 +1,120 @@
+"""Automated tests: every claimed trace is reproduced by the interpreter, or the
+claim is withdrawn.  Run:  python3 test_nabla.py   (also works under pytest)."""
+import os
+from nabla import run, run_hard, export, compile_bf
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+TOL = 1e-9
+
+
+def src(name):
+    return open(os.path.join(HERE, name)).read()
+
+
+def close(a, b, tol=TOL):
+    return abs(a - b) <= tol
+
+
+def test_learning_exact_trace():
+    """a_n = 3(1 - 0.8^n) (eta=0.1 -> a_{n+1}=0.8 a_n + 0.6); loss_n=(a_n-3)^2."""
+    r = run(src("learning.nbl"), max_steps=200)
+    a = [3 * (1 - 0.8 ** n) for n in range(12)]
+    assert len(r["out"]) == 12
+    for n in range(12):
+        assert close(r["out"][n], a[n]), (n, r["out"][n], a[n])          # OUT = a_n
+        assert close(r["grad_log"][n][0], (a[n] - 3) ** 2), n            # loss = (a_n-3)^2
+        assert close(r["grad_log"][n][1]["a"], a[n]), n                  # param before update
+    assert close(r["params"]["a"], a[11] * 0.8 + 0.6)                    # a_12
+
+
+def test_hack_freezes_and_never_reaches_target():
+    """Retargeting T:=R0 makes loss identically 0, so the param never moves and
+    the behaviour never reaches the real target 3."""
+    r = run(src("hack.nbl"), max_steps=200)
+    assert all(close(x, 0.0) for x in r["out"])
+    assert all(close(loss, 0.0) for loss, _ in r["grad_log"])
+    assert close(r["params"]["a"], 0.0)
+    assert not close(r["out"][-1], 3.0)                                  # target unreached
+
+
+def test_erasure_drives_activity_to_zero():
+    """L=activity^2, eta=0.3 -> g_n = 0.4^n -> 0; exports to an inert program."""
+    r = run(src("erasure.nbl"), max_steps=200)
+    for n in range(12):
+        assert close(r["out"][n], 0.4 ** n), (n, r["out"][n])
+    assert r["out"][-1] < 1e-3                                           # activity ~ 0
+    assert export(r["params"])["g"] == 0.0                               # rounds to inert
+
+
+def test_same_interpreter_no_demo_flags():
+    """All three run through the identical (source, input, max_steps) entry
+    point with no kind=, grad_cell, mask, or pass-count arguments."""
+    for f in ("learning.nbl", "hack.nbl", "erasure.nbl"):
+        assert "out" in run(src(f), None, 200)
+
+
+def test_export_then_hard_interp():
+    """Train (soft), hard-round the param, run the SEPARATE hard interpreter,
+    and report the rounding gap.  Hard GRAD is a no-op, so the param is frozen."""
+    r = run(src("learning.nbl"), max_steps=200)
+    hp = export(r["params"], grid=0.1)
+    assert close(hp["a"], 2.8, 1e-9)
+    rh = run_hard(src("learning.nbl"), max_steps=200, params=hp)
+    assert all(close(x, 2.8) for x in rh["out"])                        # frozen at exported value
+    soft_loss = (r["params"]["a"] - 3) ** 2
+    hard_loss = (hp["a"] - 3) ** 2
+    assert abs(soft_loss - hard_loss) < 0.01                            # rounding_gap small
+
+
+def _bf_reference(prog, inp=None):
+    """Independent unbounded-cell Brainfuck interpreter to check the reduction."""
+    mem, dp, pc, out = {}, 0, 0, []
+    inp = list(inp or [])
+    ip = 0
+    jump = {}
+    stack = []
+    for i, c in enumerate(prog):
+        if c == "[":
+            stack.append(i)
+        elif c == "]":
+            j = stack.pop(); jump[i] = j; jump[j] = i
+    while pc < len(prog):
+        c = prog[pc]
+        if c == ">":
+            dp += 1
+        elif c == "<":
+            dp -= 1
+        elif c == "+":
+            mem[dp] = mem.get(dp, 0) + 1
+        elif c == "-":
+            mem[dp] = mem.get(dp, 0) - 1
+        elif c == ".":
+            out.append(mem.get(dp, 0))
+        elif c == ",":
+            mem[dp] = inp[ip] if ip < len(inp) else 0; ip += 1
+        elif c == "[" and mem.get(dp, 0) == 0:
+            pc = jump[pc]
+        elif c == "]" and mem.get(dp, 0) != 0:
+            pc = jump[pc]
+        pc += 1
+    return out
+
+
+def test_turing_completeness_bf_reduction():
+    """NABLA has crisp branching (JZ/JMP) + unbounded tape (PTR/*), so Brainfuck
+    (a known-universal machine) reduces to it.  Assert NABLA-run output equals a
+    reference Brainfuck run on programs that use loops."""
+    for bf in ["++++++++[>++++++++<-]>+.",              # -> 65 ('A')
+               "+++++[>+++++<-]>.",                     # -> 25
+               ">,[>,]<[.<]"]:                          # reverse the input bytes
+        inp = [7, 8, 9] if "," in bf else None
+        got = run_hard(compile_bf(bf), input=inp, max_steps=1000000)["out"]
+        ref = [float(x) for x in _bf_reference(bf, inp)]
+        assert got == ref, (bf, got, ref)
