+# SELF-ERASURE: the loss IS the program's own activity, L = R0^2, and GRAD
+# drives the gain operand ~g toward 0.  g *= (1 - 2*eta) each step (eta=0.3 ->
+# x0.4): 1, 0.4, 0.16, ...  The program differentiably deletes its own output;
+# at export ~g rounds to 0 and the ADD becomes inert (behavioural erasure).
+# (Erasing the *opcode* to NOP is not gradient-reachable under hard execution --
+# structural gradient is 0 a.e. -- so erasure lives in the operand, per the
+# operand-cell law.)
+PARAM g 1
+SET C 12
+SET E 0.3
+loop:
+  SET R0 0
+  ADD R0 R0 ~g       # R0 = g   (the program's activity)
+  MUL L R0 R0        # L = activity^2   (self-referential loss)
+  OUT R0
+  GRAD               # g -= E * 2g  ->  g *= (1 - 2E)
+  ADD C C -1
+  JNZ C loop
+HALT
