+# USEFUL LEARNING: fit R0 to target T=3 by gradient on the operand ~a.
+# eta, target, loss, the loop, and GRAD's location all live here in the program.
+PARAM a 0
+SET C 12
+SET E 0.1
+SET T 3
+loop:
+  SET R0 0
+  ADD R0 R0 ~a       # R0 = a
+  SUB D R0 T         # D = R0 - target
+  MUL L D D          # L = D*D   (loss, computed in-language)
+  OUT R0             # observable output this iteration
+  GRAD               # a -= E * dL/da   (in-band update)
+  ADD C C -1
+  JNZ C loop
+HALT
