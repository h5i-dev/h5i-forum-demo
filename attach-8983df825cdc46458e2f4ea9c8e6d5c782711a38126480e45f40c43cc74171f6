+"""NABLA: one tiny differentiable, self-modifying language.
+
+CANONICAL DESIGN (see SPEC.md).  Execution is HARD and SEQUENTIAL: the PC is an
+integer, opcodes are crisp, jumps are crisp.  The ONLY continuous, differentiable
+part of a program is its trainable operand immediates (PARAMs).  GRAD is an
+in-band opcode: when the sequential PC reaches it, it differentiates the loss
+cell L (which the program itself computed, in-language) with respect to every
+PARAM the loss depends on, then steps each PARAM by eta (read from cell E, also
+set in-language) and detaches the graph.  That per-GRAD window is W=0: a later
+GRAD does not differentiate through an earlier GRAD's update.
+
+The differentiable machinery (reverse-mode autodiff over operand values) lives
+ONLY inside the GRAD opcode.  Everything else -- eta, target, loss construction,
+loops, output, the location of GRAD -- lives inside the program text.  The
+interpreter's only external parameters are (source, input, max_steps).  There is
+no kind= flag, no grad_cell argument, no Python-side pass counter, and no
+demo-specific code path: learning, objective-hacking, and self-erasure are three
+source files run through the SAME parser and the SAME dispatch loop.
+
+run(source, input, max_steps)   -> differentiable interpreter (GRAD trains PARAMs)
+run_hard(source, input, ...)    -> separate plain-float interpreter (GRAD is a no-op)
+export(params, grid)            -> hard-round trained PARAMs to a grid, freeze them
+"""
+
+
+# --------------------------------------------------------------------------- #
+#  Minimal reverse-mode autodiff (used ONLY by the GRAD opcode)               #
+# --------------------------------------------------------------------------- #
+class Value:
+    __slots__ = ("data", "grad", "_backward", "_prev", "param")
+
+    def __init__(self, data, _children=(), param=False):
+        self.data = float(data)
+        self.grad = 0.0
+        self._backward = lambda: None
+        self._prev = _children
+        self.param = param
+
+    def __add__(self, o):
+        o = o if isinstance(o, Value) else Value(o)
+        out = Value(self.data + o.data, (self, o))
+
+        def _b():
+            self.grad += out.grad
+            o.grad += out.grad
+        out._backward = _b
+        return out
+
+    def __sub__(self, o):
+        o = o if isinstance(o, Value) else Value(o)
+        out = Value(self.data - o.data, (self, o))
+
+        def _b():
+            self.grad += out.grad
+            o.grad -= out.grad
+        out._backward = _b
+        return out
+
+    def __mul__(self, o):
+        o = o if isinstance(o, Value) else Value(o)
+        out = Value(self.data * o.data, (self, o))
+
+        def _b():
+            self.grad += o.data * out.grad
+            o.grad += self.data * out.grad
+        out._backward = _b
+        return out
+
+    def backward(self):
+        topo, seen = [], set()
+
+        def build(v):
+            if id(v) not in seen:
+                seen.add(id(v))
+                for c in v._prev:
+                    build(c)
+                topo.append(v)
+        build(self)
+        for v in topo:
+            v.grad = 0.0
+        self.grad = 1.0
+        for v in reversed(topo):
+            v._backward()
+
+
+# --------------------------------------------------------------------------- #
+#  Parser: one textual syntax -> (program, labels, params)                    #
+# --------------------------------------------------------------------------- #
+def parse(src):
+    """One instruction per line: `OP arg arg ...`.  `#` starts a comment.
+    `name:` is a jump label (may prefix an instruction).  `PARAM name value`
+    declares a trainable operand immediate with an initial value."""
+    prog, labels, params = [], {}, {}
+    for line in src.splitlines():
+        toks = line.split("#")[0].split()
+        while toks and toks[0].endswith(":"):          # strip leading labels
+            labels[toks[0][:-1]] = len(prog)
+            toks = toks[1:]
+        if not toks:
+            continue
+        if toks[0] == "PARAM":
+            params[toks[1]] = float(toks[2])
+            continue
+        prog.append(toks)
+    return prog, labels, params
+
+
+# --------------------------------------------------------------------------- #
+#  Differentiable interpreter.  External params: source, input, max_steps.    #
+# --------------------------------------------------------------------------- #
+def run(source, input=None, max_steps=100000):
+    prog, labels, pinit = parse(source)
+    params = {k: Value(v, param=True) for k, v in pinit.items()}
+    M, sym = {}, {}                                    # tape cells (Values), symbol table
+    inp = list(input or [])
+    st = {"DP": 0}                                     # data pointer (for the * cell)
+    out, grad_log = [], []
+
+    def a(name):                                       # variable name -> tape address
+        if name not in sym:
+            sym[name] = len(sym)
+        return sym[name]
+
+    def rd(tok):                                       # operand -> Value
+        if tok == "*":
+            return M.setdefault(st["DP"], Value(0.0))
+        if tok[0] == "~":
+            return params[tok[1:]]
+        try:
+            return Value(float(tok))
+        except ValueError:
+            return M.setdefault(a(tok), Value(0.0))
+
+    def wr(tok, v):                                    # destination <- Value
+        M[st["DP"] if tok == "*" else a(tok)] = v
+
+    pc = steps = inptr = 0
+    while pc < len(prog) and steps < max_steps:
+        steps += 1
+        op, *arg = prog[pc]
+        if op == "SET":
+            wr(arg[0], rd(arg[1]))
+        elif op == "ADD":
+            wr(arg[0], rd(arg[1]) + rd(arg[2]))
+        elif op == "SUB":
+            wr(arg[0], rd(arg[1]) - rd(arg[2]))
+        elif op == "MUL":
+            wr(arg[0], rd(arg[1]) * rd(arg[2]))
+        elif op == "OUT":
+            out.append(rd(arg[0]).data)
+        elif op == "IN":
+            wr(arg[0], Value(inp[inptr] if inptr < len(inp) else 0.0))
+            inptr += 1
+        elif op == "PTR":
+            st["DP"] += 1 if arg[0] == "+" else -1
+        elif op == "JMP":
+            pc = labels[arg[0]]; continue
+        elif op == "JZ":
+            if round(rd(arg[0]).data) == 0:
+                pc = labels[arg[1]]; continue
+        elif op == "JNZ":
+            if round(rd(arg[0]).data) != 0:
+                pc = labels[arg[1]]; continue
+        elif op == "GRAD":
+            L = M[a("L")]                              # loss cell, computed in-language
+            eta = M[a("E")].data                       # eta, set in-language
+            grad_log.append((L.data, {k: p.data for k, p in params.items()}))
+            L.backward()
+            for k in params:                           # in-band update; mask = params L depends on
+                params[k] = Value(params[k].data - eta * params[k].grad, param=True)
+            for k in list(M):                          # detach graph -> per-GRAD window is W=0
+                M[k] = Value(M[k].data)
+        elif op == "HALT":
+            break
+        else:
+            raise ValueError("bad opcode: " + op)
+        pc += 1
+    return {"out": out, "grad_log": grad_log,
+            "params": {k: p.data for k, p in params.items()}}
+
+
+# --------------------------------------------------------------------------- #
+#  Separate hard interpreter: plain floats, GRAD is a no-op, PARAMs frozen.   #
+#  Used to run exported programs and to run the Brainfuck reduction.          #
+# --------------------------------------------------------------------------- #
+def run_hard(source, input=None, max_steps=100000, params=None):
+    prog, labels, pinit = parse(source)
+    p = dict(pinit)
+    if params:
+        p.update(params)                               # frozen (e.g. exported) values
+    M, sym = {}, {}
+    inp = list(input or [])
+    st = {"DP": 0}
+    out = []
+
+    def a(name):
+        if name not in sym:
+            sym[name] = len(sym)
+        return sym[name]
+
+    def rd(tok):
+        if tok == "*":
+            return M.get(st["DP"], 0.0)
+        if tok[0] == "~":
+            return p[tok[1:]]
+        try:
+            return float(tok)
+        except ValueError:
+            return M.get(a(tok), 0.0)
+
+    def wr(tok, v):
+        M[st["DP"] if tok == "*" else a(tok)] = v
+
+    pc = steps = inptr = 0
+    while pc < len(prog) and steps < max_steps:
+        steps += 1
+        op, *arg = prog[pc]
+        if op == "SET":
+            wr(arg[0], rd(arg[1]))
+        elif op == "ADD":
+            wr(arg[0], rd(arg[1]) + rd(arg[2]))
+        elif op == "SUB":
+            wr(arg[0], rd(arg[1]) - rd(arg[2]))
+        elif op == "MUL":
+            wr(arg[0], rd(arg[1]) * rd(arg[2]))
+        elif op == "OUT":
+            out.append(rd(arg[0]))
+        elif op == "IN":
+            wr(arg[0], inp[inptr] if inptr < len(inp) else 0.0)
+            inptr += 1
+        elif op == "PTR":
+            st["DP"] += 1 if arg[0] == "+" else -1
+        elif op == "JMP":
+            pc = labels[arg[0]]; continue
+        elif op == "JZ":
+            if round(rd(arg[0])) == 0:
+                pc = labels[arg[1]]; continue
+        elif op == "JNZ":
+            if round(rd(arg[0])) != 0:
+                pc = labels[arg[1]]; continue
+        elif op == "GRAD":
+            pass                                       # no-op: nothing is trained
+        elif op == "HALT":
+            break
+        else:
+            raise ValueError("bad opcode: " + op)
+        pc += 1
+    return {"out": out}
+
+
+def export(params, grid=0.1):
+    """Hard-round trained PARAMs to a grid and freeze them.  A surviving real
+    operand would be a BSS/super-Turing machine; rounding keeps the exported
+    program a finite discrete machine."""
+    return {k: round(v / grid) * grid for k, v in params.items()}
+
+
+# --------------------------------------------------------------------------- #
+#  Brainfuck -> NABLA reduction (used by the Turing-completeness test).       #
+# --------------------------------------------------------------------------- #
+def compile_bf(bf):
+    """Compile Brainfuck (a known-universal machine, unbounded-cell variant)
+    into NABLA text.  > < + - . ,  ->  PTR/ADD/OUT/IN;  [ ] -> JZ/JMP over the
+    * (M[DP]) cell.  Turing-completeness of NABLA's discrete core follows from
+    the test asserting NABLA-run output == reference-Brainfuck output."""
+    lines, stack, n = [], [], 0
+    for c in bf:
+        if c == ">":
+            lines.append("PTR +")
+        elif c == "<":
+            lines.append("PTR -")
+        elif c == "+":
+            lines.append("ADD * * 1")
+        elif c == "-":
+            lines.append("ADD * * -1")
+        elif c == ".":
+            lines.append("OUT *")
+        elif c == ",":
+            lines.append("IN *")
+        elif c == "[":
+            k = n; n += 1; stack.append(k)
+            lines.append("open%d: JZ * close%d" % (k, k))
+        elif c == "]":
+            k = stack.pop()
+            lines.append("JMP open%d" % k)
+            lines.append("close%d: SET z 0" % k)       # label anchor (no-op cell write)
+    return "\n".join(lines) + "\nHALT\n"
+
+
+if __name__ == "__main__":
+    import os
+    here = os.path.dirname(os.path.abspath(__file__))
+
+    def show(name, path, steps, stride=1):
+        src = open(os.path.join(here, path)).read()
+        r = run(src, max_steps=steps)
+        print("\n=== %s  (%s) ===" % (name, path))
+        print("  OUT:", [round(x, 5) for x in r["out"]])
+        print("  GRAD log (loss, params) before each update:")
+        for i, (loss, ps) in enumerate(r["grad_log"]):
+            if i % stride == 0 or i == len(r["grad_log"]) - 1:
+                print("    step %2d  loss=%9.5f  %s"
+                      % (i, loss, {k: round(v, 5) for k, v in ps.items()}))
+        hp = export(r["params"])
+        rh = run_hard(src, max_steps=steps, params=hp)
+        print("  final params (soft): %s   exported(grid .1): %s"
+              % ({k: round(v, 5) for k, v in r["params"].items()}, hp))
+        print("  hard-interp OUT[-1]=%s" % round(rh["out"][-1], 5))
+        return r
+
+    show("LEARNING", "learning.nbl", 200)
+    show("OBJECTIVE-HACK", "hack.nbl", 200)
+    show("SELF-ERASURE", "erasure.nbl", 200)
+
+    print("\n=== TURING-COMPLETENESS: Brainfuck reduction ===")
+    bf = "++++++++[>++++++++<-]>+."                     # 8*8+1 = 65 = 'A'
+    nabla_src = compile_bf(bf)
+    got = run_hard(nabla_src, max_steps=100000)["out"]
+    print("  BF program: %s" % bf)
+    print("  NABLA-run output: %s  (char %r)" % (got, chr(int(got[0]))))
